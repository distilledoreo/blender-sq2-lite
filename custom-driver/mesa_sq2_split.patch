+static D3D12_RESOURCE_STATES
+sq2_peek_state(struct d3d12_context *ctx, struct d3d12_bo *bo)
+{
+   d3d12_context_state_table_entry *sq2_e = NULL;
+   if (ctx->id != D3D12_CONTEXT_NO_ID) {
+      unsigned sq2_bit = 1 << ctx->id;
+      if (bo->local_context_state_mask & sq2_bit)
+         sq2_e = &bo->local_context_states[ctx->id];
+   }
+   if (!sq2_e)
+      sq2_e = (d3d12_context_state_table_entry *)_mesa_hash_table_u64_search(ctx->bo_state_table, bo->unique_id);
+   if (sq2_e && sq2_e->batch_end.homogenous && sq2_e->batch_end.num_subresources > 0)
+      return sq2_e->batch_end.subresource_states[0].state;
+   return (D3D12_RESOURCE_STATES)0;
+}
+
+void
+sq2_print_resource(struct d3d12_context *ctx, const char *tag, struct d3d12_resource *res)
+{
+   if (!res || !res->bo || !res->bo->res) {
+      fprintf(stderr, "D3D12 SQ2: res %s null (experimental)\n", tag);
+      return;
+   }
+   D3D12_HEAP_PROPERTIES sq2_hp = {};
+   D3D12_HEAP_FLAGS sq2_hf = D3D12_HEAP_FLAG_NONE;
+   res->bo->res->GetHeapProperties(&sq2_hp, &sq2_hf);
+   fprintf(stderr, "D3D12 SQ2: res %s ptr=%p size=%u heap=%d state=0x%x (experimental)\n",
+           tag, (void *)res, (unsigned)res->base.b.width0, (int)sq2_hp.Type, (unsigned)sq2_peek_state(ctx, res->bo));
+}
 
