--- a/build_files/cmake/platform/platform_win32.cmake
+++ b/build_files/cmake/platform/platform_win32.cmake
@@ -607,6 +607,7 @@
     warn_hardcoded_paths(BOOST)
     # This is file new in 3.4 if it does not exist, assume we are building against 3.3 libs
     set(BOOST_34_TRIGGER_FILE ${BOOST_LIBPATH}/${BOOST_PREFIX}boost_python310-${BOOST_DEBUG_POSTFIX}.lib)
+    set(BOOST_PYTHON_TRIGGER_FILE ${BOOST_34_TRIGGER_FILE})
     if(NOT EXISTS ${BOOST_34_TRIGGER_FILE})
       # The 3.3/3.4-era detection looks for boost_python built for this tree's
       # Python (3.10). The Windows arm64 dependency set is built against Python
@@ -618,6 +619,16 @@
         set(BOOST_PREFIX "lib")
       endif()
     endif()
+    # The Windows arm64 dependency set is a dynamic boost build made against
+    # Python 3.11 while this tree targets 3.10, so boost_python310 does not
+    # exist in it and can not be used to tell whether boost is dynamic. The
+    # other boost libraries follow the same layout without a Python suffix, and
+    # boost_locale is the one BOOST_ALL_DYN_LINK and ${BOOST_LIBRARIES} care
+    # about, so key the dynamic detection on it instead.
+    if(CMAKE_SYSTEM_PROCESSOR STREQUAL "ARM64")
+      set(BOOST_34_TRIGGER_FILE ${BOOST_LIBPATH}/${BOOST_PREFIX}boost_locale-${BOOST_DEBUG_POSTFIX}.lib)
+      set(BOOST_PYTHON_TRIGGER_FILE "")
+    endif()
     set(BOOST_LIBRARIES
       optimized ${BOOST_LIBPATH}/${BOOST_PREFIX}boost_date_time-${BOOST_POSTFIX}.lib
       optimized ${BOOST_LIBPATH}/${BOOST_PREFIX}boost_filesystem-${BOOST_POSTFIX}.lib
@@ -632,7 +643,7 @@
       debug ${BOOST_LIBPATH}/${BOOST_PREFIX}boost_thread-${BOOST_DEBUG_POSTFIX}.lib
       debug ${BOOST_LIBPATH}/${BOOST_PREFIX}boost_chrono-${BOOST_DEBUG_POSTFIX}.lib
     )
-    if(EXISTS ${BOOST_34_TRIGGER_FILE})
+    if(EXISTS ${BOOST_PYTHON_TRIGGER_FILE})
       if(WITH_USD)
         set(BOOST_PYTHON_LIBRARIES
           debug ${BOOST_LIBPATH}/${BOOST_PREFIX}boost_python310-${BOOST_DEBUG_POSTFIX}.lib
