--- /dev/null
+++ b/source/blender/io/usd/intern/usd_no_boost_python.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* Pre-included into every bf_usd translation unit on Windows arm64.
+ *
+ * The prebuilt arm64 USD is configured with Python support, so its generated
+ * `pxr/pxr.h` defines `PXR_PYTHON_SUPPORT_ENABLED` and
+ * `pxr/base/tf/pyObjWrapper.h` then includes `<boost/python/...>`. The arm64
+ * boost of the dependency set is bound to Python 3.11 while this tree targets
+ * 3.10, so there is no boost_python310 to link against, and Blender's USD I/O is
+ * C++ only and never calls USD's Python API.
+ *
+ * Undefining the macro here makes pyObjWrapper.h use the stub
+ * `TfPyObjWrapper`, which USD guarantees to be ABI compatible with the Python
+ * variant through static asserts on its size and alignment. It has to happen
+ * through a pre-included header: `pxr/pxr.h` only `#define`s the macro, which a
+ * `/U` switch can not undo, and pxr.h's include guard keeps this undef in
+ * effect for the rest of the translation unit. */
+
+#include "pxr/pxr.h"
+
+#undef PXR_PYTHON_SUPPORT_ENABLED
