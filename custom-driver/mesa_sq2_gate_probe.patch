From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SQ2 Mesa fork
Subject: [PATCH] d3d12: log SQ2 gate inputs (TypedUAV, shader model, per-format load/store)

Temporary debug for the SQ2 (Adreno 680 / 27.x) bring-up. Run with
D3D12_DEBUG=verbose. Decides the image-lowering design: flag false means
emulation for every format Blender reads; flag true with a few failing
formats means extend d3d12_lower_image_casts for those formats only.

diff --git a/src/gallium/drivers/d3d12/d3d12_screen.cpp b/src/gallium/drivers/d3d12/d3d12_screen.cpp
--- a/src/gallium/drivers/d3d12/d3d12_screen.cpp
+++ b/src/gallium/drivers/d3d12/d3d12_screen.cpp
@@ -921,6 +921,8 @@ can_shader_image_load_all_formats(struct d3d12_screen *screen)
 {
+   debug_printf("D3D12 SQ2: TypedUAVLoadAdditionalFormats=%d\n",
+                (int)screen->opts.TypedUAVLoadAdditionalFormats);
    if (!screen->opts.TypedUAVLoadAdditionalFormats)
       return false;

@@ -947,12 +949,17 @@ can_shader_image_load_all_formats(struct d3d12_screen *screen)
    for (unsigned i = 0; i < ARRAY_SIZE(additional_formats); ++i) {
       D3D12_FEATURE_DATA_FORMAT_SUPPORT support = { additional_formats[i] };
-      if (FAILED(screen->dev->CheckFeatureSupport(D3D12_FEATURE_FORMAT_SUPPORT, &support, sizeof(support))) ||
-         (support.Support1 & D3D12_FORMAT_SUPPORT1_TYPED_UNORDERED_ACCESS_VIEW) == D3D12_FORMAT_SUPPORT1_NONE ||
-         (support.Support2 & (D3D12_FORMAT_SUPPORT2_UAV_TYPED_LOAD | D3D12_FORMAT_SUPPORT2_UAV_TYPED_STORE)) !=
-            (D3D12_FORMAT_SUPPORT2_UAV_TYPED_LOAD | D3D12_FORMAT_SUPPORT2_UAV_TYPED_STORE))
+      HRESULT hr = screen->dev->CheckFeatureSupport(D3D12_FEATURE_FORMAT_SUPPORT, &support, sizeof(support));
+      bool tuav = SUCCEEDED(hr) &&
+         ((support.Support1 & D3D12_FORMAT_SUPPORT1_TYPED_UNORDERED_ACCESS_VIEW) != 0);
+      bool load = SUCCEEDED(hr) &&
+         ((support.Support2 & D3D12_FORMAT_SUPPORT2_UAV_TYPED_LOAD) != 0);
+      bool store = SUCCEEDED(hr) &&
+         ((support.Support2 & D3D12_FORMAT_SUPPORT2_UAV_TYPED_STORE) != 0);
+      debug_printf("D3D12 SQ2: fmt %d hr=0x%lx tuav=%d load=%d store=%d\n",
+                   (int)additional_formats[i], (long)hr, tuav, load, store);
+      if (!tuav || !load || !store)
          return false;
    }

    return true;
 }
@@ -1730,6 +1737,9 @@ d3d12_init_screen(struct d3d12_screen *screen)
             screen->max_shader_model = static_cast<dxil_shader_model>(((shader_model.HighestShaderModel & 0xf0) << 12) |
                                                                      (shader_model.HighestShaderModel & 0xf));
+            debug_printf("D3D12 SQ2: highest shader model 0x%x, max feature level 0x%x\n",
+                         (unsigned)shader_model.HighestShaderModel,
+                         (unsigned)screen->max_feature_level);
             break;
